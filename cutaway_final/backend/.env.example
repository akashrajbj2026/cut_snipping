# ---------------------------------------------------------------------------
# Provider chain — free tier only
# ---------------------------------------------------------------------------
# Gemini is the only one that reads the whole video natively, so it stays
# primary. Groq is the free fallback (works from the transcript only).
# Options: gemini | groq
PRIMARY_PROVIDER=gemini

# Tried in order if the primary fails, errors out, or finds nothing.
FALLBACK_PROVIDERS=groq

# ---------------------------------------------------------------------------
# API keys — placeholders only. Prefer putting real values in backend/.env or
# setting them as environment variables in Render. Do not commit real keys.
# Both of these are free, no-credit-card API keys:
#   GEMINI_API_KEY -> https://aistudio.google.com/apikey
#   GROQ_API_KEY   -> https://console.groq.com/keys
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# openai/gpt-oss-120b is Groq's current free-tier chat model. Do not set this
# back to llama-3.3-70b-versatile - Groq shut that one down on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# groq  -> hosted Whisper, fast, free tier, needs GROQ_API_KEY
# local -> faster-whisper on this machine, no key, no network, fully offline
TRANSCRIPT_PROVIDER=groq
WHISPER_MODEL_SIZE=small
# Groq hard-rejects audio over 25MB. We compress to MP3 first, but a very
# long video can still cross that line - past this size we skip Groq and go
# straight to the local model instead of making a request we know will fail.
GROQ_MAX_AUDIO_MB=24

# ---------------------------------------------------------------------------
# Long-video timeouts (raise these further if you're testing hour+ videos)
# ---------------------------------------------------------------------------
GEMINI_PROCESSING_TIMEOUT_SECONDS=1800
GEMINI_REQUEST_TIMEOUT_MS=900000

# ---------------------------------------------------------------------------
# Tunables
# ---------------------------------------------------------------------------
CHUNK_TARGET_SECONDS=25
FRAME_INTERVAL_SECONDS=20
MAX_FRAMES=20
MERGE_GAP_THRESHOLD=8.0
SEGMENT_PAD_SECONDS=1.0
MIN_CONFIDENCE=0.0

# ---------------------------------------------------------------------------
# Long-video chunking (videos longer than ~12 min are analyzed in parts)
# ---------------------------------------------------------------------------
ANALYSIS_CHUNK_MINUTES=10
CHUNK_OVERLAP_SECONDS=15
CHUNK_MAX_RETRIES=2
CHUNK_RETRY_WAIT_SECONDS=30

# When Gemini says "503 high demand" it is Google's side. These models are
# tried automatically (comma-separated), each retried with a growing wait.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_RETRIES_PER_MODEL=3
